{
  "name": "spark-pyspark-dev",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "dev",
  "runServices": [
    "zookeeper", "kafka", "schema-registry",
    "minio", "starrocks-fe-0", "starrocks-be-0", "superset",
    "spark-connect"
  ],
  "features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": "false",
			"azureDnsAutoDetection": "false",
			"installDockerBuildx": "false",
			"installDockerComposeSwitch": "false",
			"version": "latest",
			"dockerDashComposeVersion": "latest"
		}
	},
  "workspaceFolder": "/workspace",
  "overrideCommand": false,
  "updateRemoteUserUID": true,
  "envFile": "../.env",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "GitHub.copilot",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  },

  "postCreateCommand": "uv sync --locked  && uv run pre-commit install",
  "mounts": [
    "source=uv-cache,target=/root/.cache/uv,type=volume"
  ]
}
